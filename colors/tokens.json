  "logo": {
    "mark-champagne-light": {
      "$type": "color",
      "$value": "#efe3d1"
    },
    "mark-champagne-mid": {
      "$type": "color",
      "$value": "#c9b496"
    },
    "mark-champagne-dark": {
      "$type": "color",
      "$value": "#8d7a62"
    },
    "mark-green-light": {
      "$type": "color",
      "$value": "#3f6152"
    },
    "mark-green-mid": {
      "$type": "color",
      "$value": "#2c493d"
    },
    "mark-green-dark": {
      "$type": "color",
      "$value": "#1d3229"
    },
    "mark-flat-band": {
      "$type": "color",
      "$value": "#46695a"
    },
    "mark-flat-fold": {
      "$type": "color",
      "$value": "#2c493d"
    },
    "mark-flat-arch": {
      "$type": "color",
      "$value": "#d6c4a6"
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Archivo",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "fontStretch": {
    "display": {
      "$type": "string",
      "$value": "118%"
    }
  },
  "letterSpacing": {
    "display": {
      "$type": "dimension",
      "$value": "-0.02em"
    },
    "eyebrow": {
      "$type": "dimension",
      "$value": "0.16em"
    }
  },
  "radius": {
    "control": {
      "$type": "dimension",
      "$value": "8px"
    },
    "card": {
      "$type": "dimension",
      "$value": "12px"
    }
  },
  "shadow": {
    "card": {
      "$type": "string",
      "$value": "0 1px 0 rgb(20 20 18 / 0.04), 0 1px 2px rgb(20 20 18 / 0.04)"
    },
    "lift": {
      "$type": "string",
      "$value": "0 1px 0 rgb(20 20 18 / 0.04), 0 8px 24px -8px rgb(20 20 18 / 0.14)"
    }
  },
  "motion": {
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0.7,
        0.2,
        1
      ]
    },
    "fast": {
      "$type": "duration",
      "$value": "150ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "300ms"
    }
  }
}
