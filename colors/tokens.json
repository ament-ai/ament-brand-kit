    },
    "info-soft": {
      "$type": "color",
      "$value": "#e3ebf1",
      "$description": "Information background"
    },
    "danger": {
      "$type": "color",
      "$value": "#a8432f",
      "$description": "Errors, destructive actions"
    },
    "danger-soft": {
      "$type": "color",
      "$value": "#f5e5df",
      "$description": "Error background"
    }
