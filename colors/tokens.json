      "$value": "#0d0d0c",
      "$description": "Dark chrome: sidebars, auth, display screens"
    },
    "graphite-2": {
      "$type": "color",
      "$value": "#161614",
      "$description": "Raised dark panels"
    },
    "graphite-3": {
      "$type": "color",
      "$value": "#22211e",
      "$description": "Dark hover / tertiary dark surface"
